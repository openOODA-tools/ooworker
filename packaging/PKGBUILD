# Maintainer: openOODA-tools <ops@openooda.org>
pkgname=ooworker-bin
_pkgname=ooworker
pkgver=0.1.0
pkgrel=1
pkgdesc="Micro-task scheduling worker communicating over stdio pipes with capability constraints."
arch=('x86_64')
url="https://github.com/openOODA-tools/ooworker"
license=('Apache-2.0')
depends=('glibc')
provides=('ooworker')
conflicts=('ooworker')
source_x86_64=("${url}/releases/download/v${pkgver}/ooworker-linux-x86_64"
               "uninstall.sh::https://raw.githubusercontent.com/openOODA-tools/${_pkgname}/v${pkgver}/uninstall.sh")
sha256sums_x86_64=('SKIP'
                   'SKIP')

package() {
    install -Dm755 "${srcdir}/ooworker-linux-x86_64" "${pkgdir}/usr/bin/ooworker"
    install -Dm755 uninstall.sh "${pkgdir}/usr/bin/ooworker-uninstall"
}
